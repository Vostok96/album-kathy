<div class="night-sky-container" aria-hidden="true">
    <div class="stars-bg"></div>
    <img src="/assets/luna-optimizada.webp" class="the-moon" alt="" width="84" height="104" decoding="async" />
    <div class="comet c1"></div>
    <div class="comet c2"></div>
    <div class="comet c3"></div>
</div>

<style>
    .night-sky-container {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
        transition: opacity 1.5s ease-in-out;
    }

    :global(body.night) .night-sky-container {
        opacity: 1;
    }

    .stars-bg {
        position: absolute;
        inset: 0;
        background-image: url('/assets/estrellas-optimizadas.webp');
        background-repeat: repeat;
        background-size: 360px;
        opacity: 0.4;
    }

    .the-moon {
        position: absolute;
        top: 2rem;
        right: 2rem;
        width: 84px;
        height: auto;
        opacity: 0.88;
        filter: drop-shadow(0 0 18px rgba(255, 250, 211, 0.36));
    }

    .comet {
        position: absolute;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.9);
        opacity: 0;
        animation: shoot linear infinite;
    }

    .comet::before {
        position: absolute;
        top: 50%;
        width: 150px;
        height: 1px;
        background: linear-gradient(90deg, #fff, transparent);
        content: '';
        transform: translateY(-50%);
    }

    .c1 { top: 12%; left: 82%; animation-delay: 1s; animation-duration: 5s; }
    .c2 { top: 28%; left: 95%; animation-delay: 4s; animation-duration: 6s; }
    .c3 { top: 42%; left: 74%; animation-delay: 7s; animation-duration: 5.5s; }

    @keyframes shoot {
        0% { opacity: 0; transform: rotate(315deg) translateX(0); }
        12% { opacity: 0.9; }
        100% { opacity: 0; transform: rotate(315deg) translateX(-760px); }
    }
</style>
