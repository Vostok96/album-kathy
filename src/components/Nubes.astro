<div class="clouds-container" aria-hidden="true">
    <div class="cloud cloud-1"></div>
    <div class="cloud cloud-2"></div>
</div>

<style>
    .clouds-container {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .cloud {
        position: absolute;
        inset: 0 auto auto 0;
        width: 200%;
        height: 100%;
        background-image: url('/assets/nube-optimizada.webp');
        background-position: center top;
        background-repeat: repeat-x;
        background-size: contain;
        opacity: 0.42;
        transition: filter 1s ease, opacity 1s ease;
    }

    .cloud-1 {
        animation: move-clouds 70s linear infinite;
    }

    .cloud-2 {
        top: 13%;
        opacity: 0.24;
        animation: move-clouds 56s linear infinite reverse;
    }

    :global(body.sunset) .cloud {
        filter: sepia(1) saturate(2.4) hue-rotate(-18deg) opacity(0.78);
    }

    :global(body.night) .cloud {
        opacity: 0.19;
        filter: brightness(0.16) contrast(1.2);
    }

    @keyframes move-clouds {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
</style>
