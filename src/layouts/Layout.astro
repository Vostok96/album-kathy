---
interface Props {
	title?: string;
}

const { title = 'Nuestra Historia ❤️' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f7c6d0" />
		<meta
			name="description"
			content="Un mapa de recuerdos, viajes y pequeños momentos compartidos."
		/>
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Montserrat:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<script>
			function setTimeTheme() {
				const hour = new Date().getHours();
				const body = document.body;
				body.classList.remove('day', 'sunset', 'night');

				if (hour >= 6 && hour < 17) {
					body.classList.add('day');
				} else if (hour >= 17 && hour < 19) {
					body.classList.add('sunset');
				} else {
					body.classList.add('night');
				}
			}

			setTimeTheme();
			setInterval(setTimeTheme, 15 * 60 * 1000);
		</script>
	</body>
</html>

<style is:global>
	:root {
		--primary: #c62f5a;
		--primary-dark: #8f2044;
		--primary-soft: #fff0f4;
		--text-color: #442b39;
		--muted-color: #765b68;
		--glass: rgba(255, 255, 255, 0.66);
		--glass-strong: rgba(255, 255, 255, 0.82);
		--glass-border: rgba(255, 255, 255, 0.58);
		--shadow: 0 18px 50px rgba(114, 52, 78, 0.14);
		--bg-gradient:
			radial-gradient(circle at 10% 8%, rgba(255, 255, 255, 0.66), transparent 30%),
			linear-gradient(135deg, #ffe5e8 0%, #f8d7eb 48%, #cfe8ff 100%);
	}

	* {
		box-sizing: border-box;
	}

	html {
		min-height: 100%;
		scroll-behavior: smooth;
		font-family: 'Montserrat', sans-serif;
	}

	body {
		min-height: 100vh;
		margin: 0;
		background-attachment: fixed;
		background-image: var(--bg-gradient);
		color: var(--text-color);
		transition: background 1s ease, color 1s ease;
	}

	body.day {
		--bg-gradient:
			radial-gradient(circle at 12% 10%, rgba(255, 255, 255, 0.78), transparent 28%),
			linear-gradient(140deg, #fce4ec 0%, #e5f3ff 48%, #bde3fb 100%);
	}

	body.sunset {
		--text-color: #541f3b;
		--muted-color: #73425a;
		--bg-gradient:
			radial-gradient(circle at 16% 8%, rgba(255, 243, 209, 0.7), transparent 28%),
			linear-gradient(150deg, #ffd1c9 0%, #f8b1ca 42%, #9376bd 100%);
	}

	body.night {
		--text-color: #fff7fa;
		--muted-color: #e7cbd4;
		--glass: rgba(13, 31, 48, 0.58);
		--glass-strong: rgba(15, 31, 49, 0.78);
		--glass-border: rgba(255, 255, 255, 0.14);
		--shadow: 0 20px 55px rgba(0, 0, 0, 0.26);
		--bg-gradient: linear-gradient(145deg, #0c1829 0%, #17354c 52%, #2b5363 100%);
	}

	button {
		font: inherit;
	}

	button:focus-visible,
	a:focus-visible {
		outline: 3px solid rgba(198, 47, 90, 0.48);
		outline-offset: 3px;
	}

	h1,
	h2,
	h3 {
		margin-top: 0;
		font-family: 'Dancing Script', cursive;
	}

	::selection {
		background: #e66a8c;
		color: #fff;
	}

	::-webkit-scrollbar {
		width: 9px;
	}

	::-webkit-scrollbar-track {
		background: rgba(255, 255, 255, 0.22);
	}

	::-webkit-scrollbar-thumb {
		border: 2px solid rgba(255, 255, 255, 0.5);
		border-radius: 20px;
		background: linear-gradient(#c62f5a, #e66a8c);
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			scroll-behavior: auto !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
