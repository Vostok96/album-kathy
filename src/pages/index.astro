---
import Layout from '../layouts/Layout.astro';
import ElefanteSombra from '../components/ElefanteSombra.astro';
import Lluvia from '../components/Lluvia.astro';
import Mapa from '../components/Mapa.astro';
import Noche from '../components/Noche.astro';
import Nubes from '../components/Nubes.astro';
---

<Layout title="Nuestra historia, lugar por lugar ❤️">
	<ElefanteSombra />
	<Noche />
	<Lluvia />
	<Nubes />

	<main>
		<header class="hero">
			<p class="eyebrow">Un pequeño atlas de nosotros</p>
			<h1>Nuestra historia,<span>lugar por lugar</span></h1>
			<p class="hero-copy">
				De la sierra al mar, cada parada guarda una versión bonita de nosotros.
				Este mapa todavía tiene mucho espacio para seguir creciendo.
			</p>
			<div class="hero-badges" aria-label="Resumen de nuestra historia">
				<span>13 rincones</span>
				<span>2 hitos y una promesa</span>
				<span>∞ recuerdos por crear</span>
			</div>
		</header>

		<section class="milestones-section" aria-labelledby="milestones-title">
			<div class="milestones-heading">
				<p class="eyebrow">Nuestra línea de tiempo</p>
				<h2 id="milestones-title">Tres latidos de nuestra historia</h2>
				<p>Cada fecha es un comienzo. La más bonita todavía la estamos soñando.</p>
			</div>

			<div class="milestones">
				<article class="milestone-card glass">
					<span class="milestone-marker" aria-hidden="true">♥</span>
					<p class="counter-kicker">Nuestro primer capítulo</p>
					<h3>Nuestra aventura empezó</h3>
					<p class="counter-date">5 de diciembre de 2025</p>
					<div class="timer" aria-label="Tiempo desde que empezó nuestra aventura">
						<div><strong id="aventura-dias">0</strong><span>días</span></div>
						<div><strong id="aventura-horas">0</strong><span>horas</span></div>
						<div><strong id="aventura-minutos">0</strong><span>min</span></div>
						<div><strong id="aventura-segundos">0</strong><span>seg</span></div>
					</div>
				</article>

				<article class="milestone-card glass is-highlighted">
					<span class="milestone-marker" aria-hidden="true">♥</span>
					<p class="counter-kicker">El día de nuestro sí</p>
					<h3>Novios desde</h3>
					<p class="counter-date">1 de marzo de 2026</p>
					<div class="timer" aria-label="Tiempo desde que somos novios">
						<div><strong id="novios-dias">0</strong><span>días</span></div>
						<div><strong id="novios-horas">0</strong><span>horas</span></div>
						<div><strong id="novios-minutos">0</strong><span>min</span></div>
						<div><strong id="novios-segundos">0</strong><span>seg</span></div>
					</div>
				</article>

				<article class="milestone-card glass is-upcoming">
					<span class="milestone-marker" aria-hidden="true">✦</span>
					<p class="counter-kicker">Nuestra próxima promesa</p>
					<h3>Esposos</h3>
					<p class="upcoming-label">Próximamente</p>
					<p class="upcoming-copy">Un para siempre que iremos escribiendo juntos.</p>
				</article>
			</div>
		</section>

		<section class="map-section">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Nuestro recorrido</p>
					<h2>Un mapa lleno de pequeñas historias</h2>
				</div>
				<p>Toca un corazón o elige un lugar para abrir sus fotos.</p>
			</div>
			<Mapa />
		</section>

		<section class="love-note glass">
			<span class="note-mark" aria-hidden="true">“</span>
			<div>
				<p class="eyebrow">Nota para ti</p>
				<h2>Lo mejor no son los lugares</h2>
				<p>
					Es coincidir contigo en ellos. Que este mapa siga sumando escapadas,
					conversaciones largas y recuerdos que todavía no sabemos que vamos a querer guardar.
				</p>
			</div>
		</section>

		<div class="music-player">
			<button id="playBtn" type="button" aria-label="Reproducir nuestra canción">
				<span class="music-icon" aria-hidden="true">♫</span>
				<span id="musicLabel">Nuestra canción</span>
			</button>
			<audio id="cancion" loop preload="none">
				<source src="/assets/nuestra-cancion.mp3" type="audio/mpeg" />
			</audio>
		</div>

		<footer class="scientific-footer">
			<p>Hecho con <span aria-hidden="true">♥</span> por Denis</p>
			<small>“Nuestra conexión es más fuerte que un enlace covalente.”</small>
		</footer>
	</main>
</Layout>

<style>
	main {
		position: relative;
		z-index: 1;
		width: min(1120px, calc(100% - 2rem));
		margin: auto;
		padding: 4rem 0 2rem;
	}

	.glass {
		border: 1px solid var(--glass-border);
		background: var(--glass);
		box-shadow: var(--shadow);
		backdrop-filter: blur(16px);
	}

	.hero {
		max-width: 820px;
		margin: 0 auto 2.2rem;
		text-align: center;
		animation: rise-in 0.85s ease both;
	}

	.eyebrow {
		margin: 0 0 0.55rem;
		color: var(--primary);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}

	h1 {
		margin-bottom: 1rem;
		color: var(--primary);
		font-size: clamp(3.8rem, 9vw, 6.8rem);
		line-height: 0.86;
		text-shadow: 0 5px 20px rgba(144, 39, 73, 0.14);
	}

	h1 span {
		display: block;
		color: var(--primary-dark);
		font-size: 0.7em;
	}

	:global(body.night) h1 span {
		color: #f7becd;
	}

	.hero-copy {
		max-width: 680px;
		margin: auto;
		color: var(--muted-color);
		font-size: 1rem;
		line-height: 1.8;
	}

	.hero-badges {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.55rem;
		margin-top: 1.35rem;
	}

	.hero-badges span {
		padding: 0.5rem 0.75rem;
		border: 1px solid rgba(198, 47, 90, 0.12);
		border-radius: 99px;
		background: rgba(255, 255, 255, 0.42);
		color: var(--primary-dark);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	:global(body.night) .hero-badges span {
		border-color: rgba(255, 255, 255, 0.12);
		background: rgba(0, 0, 0, 0.14);
		color: #f9d4dd;
	}

	.milestones-section {
		margin: 0 auto 3.8rem;
		animation: rise-in 0.85s 0.12s ease both;
	}

	.milestones-heading {
		max-width: 690px;
		margin: 0 auto 1.35rem;
		text-align: center;
	}

	.milestones-heading h2 {
		font-size: clamp(2.6rem, 6vw, 4rem);
	}

	.milestones-heading > p:last-child {
		margin: 0.65rem auto 0;
		color: var(--muted-color);
		font-size: 0.88rem;
		line-height: 1.7;
	}

	.milestones {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.milestones::before {
		position: absolute;
		top: 1.45rem;
		right: 14%;
		left: 14%;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(198, 47, 90, 0.38), transparent);
		content: '';
	}

	.milestone-card {
		position: relative;
		min-width: 0;
		padding: 2.8rem 1rem 1rem;
		border-radius: 23px;
		text-align: center;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.milestone-card:hover {
		transform: translateY(-5px);
	}

	.milestone-card.is-highlighted {
		border-color: rgba(198, 47, 90, 0.28);
		background:
			linear-gradient(rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.16)),
			var(--glass);
	}

	.milestone-marker {
		position: absolute;
		top: 0.65rem;
		left: 50%;
		display: grid;
		width: 36px;
		height: 36px;
		place-items: center;
		border: 1px solid rgba(198, 47, 90, 0.16);
		border-radius: 50%;
		background: var(--glass-strong);
		box-shadow: 0 6px 17px rgba(143, 32, 68, 0.14);
		color: var(--primary);
		font-size: 1.12rem;
		transform: translateX(-50%);
		animation: marker-heartbeat 1.8s infinite;
	}

	.is-upcoming .milestone-marker {
		animation: twinkle 2.2s ease-in-out infinite;
	}

	.counter-kicker,
	.counter-date {
		margin: 0;
	}

	.counter-kicker {
		color: var(--muted-color);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.counter-date {
		margin-top: 0.18rem;
		color: var(--primary-dark);
		font-family: 'Dancing Script', cursive;
		font-size: 1.38rem;
		font-weight: 700;
	}

	:global(body.night) .counter-date {
		color: #f9c7d3;
	}

	.timer {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.32rem;
		margin-top: 0.8rem;
		font-variant-numeric: tabular-nums;
	}

	.timer div {
		min-width: 0;
		padding: 0.44rem 0.2rem;
		border-radius: 13px;
		background: rgba(255, 255, 255, 0.46);
		text-align: center;
	}

	:global(body.night) .timer div {
		background: rgba(255, 255, 255, 0.08);
	}

	.timer strong,
	.timer span {
		display: block;
	}

	.timer strong {
		color: var(--primary);
		font-size: 0.98rem;
	}

	.timer span {
		margin-top: 0.12rem;
		color: var(--muted-color);
		font-size: 0.48rem;
		font-weight: 700;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.milestone-card h3 {
		margin: 0.3rem 0 0;
		color: var(--primary-dark);
		font-size: 2rem;
		line-height: 1;
	}

	:global(body.night) .milestone-card h3 {
		color: #f9c7d3;
	}

	.upcoming-label {
		margin: 0.58rem 0 0;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.upcoming-copy {
		max-width: 250px;
		margin: 0.66rem auto 0;
		color: var(--muted-color);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.map-section {
		animation: rise-in 0.85s 0.22s ease both;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 0 1rem;
	}

	h2 {
		margin-bottom: 0;
		color: var(--primary-dark);
		font-size: clamp(2.35rem, 6vw, 3.5rem);
		line-height: 1;
	}

	:global(body.night) h2 {
		color: #f9c7d3;
	}

	.section-heading > p {
		max-width: 310px;
		margin: 0 0 0.18rem;
		color: var(--muted-color);
		font-size: 0.82rem;
		line-height: 1.6;
		text-align: right;
	}

	.love-note {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1.15rem;
		max-width: 880px;
		margin: 3.5rem auto 0;
		padding: 1.5rem 1.75rem 1.65rem;
		overflow: hidden;
		border-radius: 24px;
	}

	.note-mark {
		height: 2.4rem;
		color: var(--primary);
		font-family: 'Dancing Script', cursive;
		font-size: 5rem;
		line-height: 0.8;
	}

	.love-note h2 {
		font-size: clamp(2rem, 5vw, 3rem);
	}

	.love-note div > p:last-child {
		max-width: 700px;
		margin: 0.8rem 0 0;
		color: var(--muted-color);
		font-size: 0.92rem;
		line-height: 1.8;
	}

	.music-player {
		position: fixed;
		right: 1.2rem;
		bottom: 1.2rem;
		z-index: 1000;
	}

	.music-player button {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.78rem 1rem;
		border: 1px solid var(--glass-border);
		border-radius: 99px;
		background: var(--glass-strong);
		box-shadow: 0 8px 24px rgba(86, 41, 61, 0.15);
		color: var(--primary);
		cursor: pointer;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
		backdrop-filter: blur(16px);
	}

	.music-player button:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 28px rgba(86, 41, 61, 0.22);
	}

	.music-player button.is-playing .music-icon {
		animation: heartbeat 1.25s infinite;
	}

	.music-icon {
		display: grid;
		width: 29px;
		height: 29px;
		place-items: center;
		border-radius: 50%;
		background: rgba(198, 47, 90, 0.1);
		font-size: 1rem;
	}

	.scientific-footer {
		padding: 3.6rem 0 1rem;
		color: var(--muted-color);
		text-align: center;
	}

	.scientific-footer p {
		margin: 0;
		color: var(--primary);
		font-weight: 700;
	}

	.scientific-footer small {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.72rem;
		font-style: italic;
	}

	@keyframes rise-in {
		from { opacity: 0; transform: translateY(18px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes heartbeat {
		0%, 42%, 100% { transform: scale(1); }
		12%, 28% { transform: scale(1.13); }
	}

	@keyframes twinkle {
		0%, 100% { transform: translateX(-50%) rotate(0deg) scale(1); }
		50% { transform: translateX(-50%) rotate(16deg) scale(1.15); }
	}

	@keyframes marker-heartbeat {
		0%, 42%, 100% { transform: translateX(-50%) scale(1); }
		12%, 28% { transform: translateX(-50%) scale(1.13); }
	}

	@media (max-width: 760px) {
		main {
			width: min(100% - 1.1rem, 1120px);
			padding-top: 3rem;
		}

		.hero-copy {
			font-size: 0.9rem;
		}

		.milestones-section {
			margin-bottom: 2.8rem;
		}

		.milestones {
			grid-template-columns: 1fr;
			gap: 0.65rem;
		}

		.milestones::before {
			top: 3rem;
			bottom: 3rem;
			left: 1.26rem;
			width: 1px;
			height: auto;
			background: linear-gradient(transparent, rgba(198, 47, 90, 0.38), transparent);
		}

		.milestone-card {
			padding: 1rem 0.8rem 1rem 3.1rem;
			text-align: left;
		}

		.milestone-marker {
			top: 1rem;
			left: 1.26rem;
		}

		.upcoming-copy {
			max-width: none;
			margin-left: 0;
		}

		.section-heading {
			display: block;
		}

		.section-heading > p {
			margin-top: 0.65rem;
			text-align: left;
		}

		.love-note {
			grid-template-columns: 1fr;
			gap: 0;
			margin-top: 2.6rem;
			padding: 1.25rem;
		}

		.note-mark {
			height: 1.5rem;
			font-size: 4rem;
		}

		.music-player {
			right: 0.72rem;
			bottom: 0.72rem;
		}
	}
</style>

<script>
	const button = document.getElementById('playBtn');
	const audio = document.getElementById('cancion');
	const label = document.getElementById('musicLabel');

	if (button instanceof HTMLButtonElement && audio instanceof HTMLAudioElement && label) {
		button.addEventListener('click', async () => {
			if (audio.paused) {
				await audio.play();
				label.textContent = 'Pausar canción';
				button.classList.add('is-playing');
				button.setAttribute('aria-label', 'Pausar nuestra canción');
			} else {
				audio.pause();
				label.textContent = 'Nuestra canción';
				button.classList.remove('is-playing');
				button.setAttribute('aria-label', 'Reproducir nuestra canción');
			}
		});
	}

	const milestones = [
		{ prefix: 'aventura', startDate: new Date('2025-12-05T00:00:00') },
		{ prefix: 'novios', startDate: new Date('2026-03-01T00:00:00') },
	];

	function updateCounter({ prefix, startDate }) {
		const difference = Math.max(0, Date.now() - startDate.getTime());
		const day = 1000 * 60 * 60 * 24;
		const hour = 1000 * 60 * 60;
		const minute = 1000 * 60;
		const values = {
			[`${prefix}-dias`]: Math.floor(difference / day),
			[`${prefix}-horas`]: Math.floor((difference % day) / hour),
			[`${prefix}-minutos`]: Math.floor((difference % hour) / minute),
			[`${prefix}-segundos`]: Math.floor((difference % minute) / 1000),
		};

		for (const [id, value] of Object.entries(values)) {
			const element = document.getElementById(id);
			if (element) element.textContent = String(value);
		}
	}

	function updateMilestones() {
		milestones.forEach(updateCounter);
	}

	updateMilestones();
	setInterval(updateMilestones, 1000);
</script>
